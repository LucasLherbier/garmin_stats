diff --git a/api/main.py b/api/main.py
index a0e4761..03e50a3 100644
--- a/api/main.py
+++ b/api/main.py
@@ -49,6 +49,27 @@ app.add_middleware(
     allow_headers=["*"],
 )
 
+
+@app.middleware("http")
+async def api_cache_headers(request, call_next):
+    """Let the browser reuse data GETs for a few minutes.
+
+    Training data changes at most weekly (on sync), so a 5-minute browser
+    cache is safe and makes back/forward navigation and reloads instant.
+    Sync/status/download endpoints are excluded — they must stay live.
+    """
+    response = await call_next(request)
+    path = request.url.path
+    if (
+        request.method == "GET"
+        and path.startswith("/api/")
+        and not path.startswith(("/api/sync", "/api/health", "/api/report/download"))
+    ):
+        response.headers["Cache-Control"] = (
+            "private, max-age=300, stale-while-revalidate=600"
+        )
+    return response
+
 app.include_router(overview.router, prefix="/api")
 app.include_router(sports.router, prefix="/api")
 app.include_router(races.router, prefix="/api")
